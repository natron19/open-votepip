<div class="d-flex justify-content-between align-items-start mb-3 gap-3">
  <div>
    <h1 class="h3 mb-1"><%= @proposal.title %></h1>
    <p class="text-muted small mb-0">
      <%= link_to "← My proposals", proposals_path, class: "text-muted" %>
      &nbsp;&middot;&nbsp; <%= @proposal.decider_label %>
    </p>
  </div>
  <div class="d-flex gap-2 flex-shrink-0">
    <%= link_to "Edit", edit_proposal_path(@proposal), class: "btn btn-outline-secondary btn-sm" %>
    <%= button_to "Delete", proposal_path(@proposal),
          method: :delete,
          form: { data: { turbo_confirm: "Delete this proposal and its clarity checks?" } },
          class: "btn btn-outline-danger btn-sm" %>
  </div>
</div>

<div class="card mb-4" style="max-width: 820px;">
  <div class="card-body">
    <p class="draft-text mb-3"><%= @proposal.body %></p>
    <dl class="row mb-0 small">
      <dt class="col-sm-4 text-muted">What problem it solves</dt>
      <dd class="col-sm-8"><%= @proposal.problem %></dd>
      <dt class="col-sm-4 text-muted">Who decides</dt>
      <dd class="col-sm-8"><%= @proposal.decider_label %></dd>
      <dt class="col-sm-4 text-muted">Deadline or cost</dt>
      <dd class="col-sm-8 mb-0"><%= @proposal.deadline_or_cost.presence || "Not stated" %></dd>
    </dl>
  </div>
</div>

<div class="mb-4" style="max-width: 820px;">
  <%= render "proposals/check_button", proposal: @proposal, label: "Check clarity", button_class: "btn btn-primary" %>
  <p class="text-muted small mt-2 mb-0">
    The check reads only the draft above, never who wrote it. It says whether this is one proposal people can
    answer yes or no, what a reader would still ask, and two small edits. It does not judge whether the idea is
    good. Typically takes 5&ndash;15 seconds.
  </p>
</div>

<% if @clarity_checks.any? %>
  <h2 class="h6 text-muted mb-2">Earlier checks</h2>
  <ul class="list-unstyled small" style="max-width: 820px;">
    <% @clarity_checks.each do |check| %>
      <li class="mb-2">
        <%= link_to proposal_clarity_check_path(@proposal, check) do %>
          <%= check.generated_at ? "#{time_ago_in_words(check.generated_at)} ago" : "Unknown time" %>
        <% end %>
        &nbsp;
        <% if check.completed? %>
          <%= render "proposals/verdict_badges", check: check %>
        <% else %>
          <span class="text-muted fst-italic"><%= check.status == "failed" ? "could not be read" : "still running" %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
