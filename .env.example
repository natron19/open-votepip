# ── App Branding ───────────────────────────────────────────────────────────────
APP_NAME="VotePIP Demo"
APP_TAGLINE="A rough proposal in. A clear, votable motion out."
APP_DESCRIPTION="An open source, single-feature demo of VotePIP."

# ── Database ───────────────────────────────────────────────────────────────────
# DATABASE_URL=postgres://localhost/open_votepip_development  # optional override

# ── Google Gemini ──────────────────────────────────────────────────────────────
# Get your free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── AI Operational Limits ──────────────────────────────────────────────────────
AI_CALLS_PER_USER_PER_DAY=50
AI_GLOBAL_TIMEOUT_SECONDS=45
